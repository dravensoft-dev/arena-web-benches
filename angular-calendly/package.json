{
  "name": "ng-calendly-bench",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "prebuild": "arena build --src src --src design && arena audit --src src --src design --strict=audit && arena usage --src src --src design",
    "compile": "ngc -p tsconfig.app.json --outDir .ngc --rootDir . --sourceMap false",
    "bundle": "rollup -c",
    "finish": "node finish.mjs",
    "build": "bun run compile && bun run bundle && bun run finish",
    "measure": "bun run prebuild && bun measure.ts",
    "prestart": "arena build --src src --src design && arena audit --src src --src design",
    "start": "ng serve --port 5208",
    "report": "arena build --src src --src design && arena check --src src --src design && arena audit --src src --src design && arena usage --src src --src design"
  },
  "dependencies": {
    "@angular/cdk": "22.2.4",
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@dravensoft/arena-angular": "file:../vendor/dravensoft-arena-angular-12.1.1.tgz",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.4",
    "@angular/cli": "22.2.4",
    "@angular/compiler-cli": "22.2.3",
    "@babel/core": "8.0.9",
    "@benches/kit": "file:../bench-kit/src",
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-replace": "6.0.3",
    "@rollup/plugin-terser": "1.0.2",
    "rollup": "4.65.0",
    "typescript": "6.0.3"
  }
}
