{
  "name": "ng-superhuman-bench",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "prebuild": "arena build --src src --src design && arena audit --src src --src design --strict=audit && arena usage --src src --src design",
    "bundle": "rspack build -c rspack.config.mjs",
    "finish": "node finish.mjs",
    "build": "bun run bundle && bun run finish",
    "measure": "bun run prebuild && bun measure.ts",
    "prestart": "arena build --src src --src design && arena audit --src src --src design",
    "start": "ng serve --port 5206",
    "report": "arena build --src src --src design && arena check --src src --src design && arena audit --src src --src design && arena usage --src src --src design"
  },
  "@parcel/bundler-default": {
    "manualSharedBundles": [
      {
        "name": "arena",
        "root": "index.html",
        "assets": [
          "**/node_modules/@dravensoft/arena-angular/**"
        ]
      },
      {
        "name": "arenapkg",
        "root": "index.html",
        "types": [
          "css"
        ],
        "assets": [
          "**/src/arena.package.generated.css"
        ]
      }
    ]
  },
  "@parcel/resolver-default": {
    "packageExports": true
  },
  "dependencies": {
    "@angular/cdk": "22.2.4",
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@dravensoft/arena-angular": "13.0.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.4",
    "@angular/cli": "22.2.4",
    "@angular/compiler-cli": "22.2.3",
    "@benches/kit": "file:../bench-kit/src",
    "@nx/angular-rspack": "24.0.1",
    "@rspack/cli": "2.2.9",
    "@rspack/core": "2.2.9",
    "typescript": "6.0.3"
  }
}
