{
  "name": "arena-web-benches",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "homepage": "https://arena.dravensoft.org/web-benches/",
  "scripts": {
    "build": "bun scripts/build.ts",
    "bundlers": "bun scripts/bundlers.ts",
    "compare": "bun scripts/compare.ts",
    "test": "bun test scripts",
    "test:kit": "bun test bench-kit",
    "test:contract": "bun test --timeout 900000 --path-ignore-patterns 'nothing/**' scripts/halves/contract.test.ts scripts/halves/cache.test.ts",
    "pack": "bun scripts/pack.ts",
    "rotate": "bun scripts/rotate.ts"
  }
}
